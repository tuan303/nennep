# ============ Firebase – client (public, from Firebase console > Project settings > Your apps) ============
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional sign-in buttons (accounts must still be created by an Admin in the app)
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_MICROSOFT=false
# Local development against Firebase emulators only
NEXT_PUBLIC_USE_EMULATORS=false

# ============ Firebase Admin – server (SECRET, from a service account key JSON) ============
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Alternative to the 3 variables above: the whole service-account JSON, base64-encoded
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Comma-separated emails that become ADMIN automatically on their first sign-in. Leave EMPTY in production and use
# `npm run create-admin` instead. It only works for a VERIFIED email (Google/Microsoft, or a verified Email/Password
# account) and only while no active ADMIN exists yet.
BOOTSTRAP_ADMIN_EMAILS=

# Firestore transport on the server. Default: REST in production (faster cold starts on Vercel), gRPC on the emulators.
# Set to "false" to force gRPC in production.
FIRESTORE_PREFER_REST=

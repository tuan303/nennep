# ============ Firebase – client (public, from Firebase console > Project settings > Your apps) ============
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional sign-in buttons (accounts must still be created by an Admin in the app)
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_MICROSOFT=false
# Local development against Firebase emulators only
NEXT_PUBLIC_USE_EMULATORS=false

# ============ Firebase Admin – server (SECRET, from a service account key JSON) ============
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Alternative to the 3 variables above: the whole service-account JSON, base64-encoded
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Comma-separated emails that become ADMIN automatically on their first sign-in. Leave EMPTY in production and use
# `npm run create-admin` instead. It only works for a VERIFIED email (Google/Microsoft, or a verified Email/Password
# account) and only while no active ADMIN exists yet.
BOOTSTRAP_ADMIN_EMAILS=

# Firestore transport on the server. Default: REST in production (faster cold starts on Vercel), gRPC on the emulators.
# Set to "false" to force gRPC in production.
FIRESTORE_PREFER_REST=

# ============ Email (Microsoft 365 via Microsoft Graph) – SERVER ONLY, all optional ============
# Without the four values below the app works normally; Cài đặt → Email shows "Chưa cấu hình" and lists what is missing.
# App registration in Microsoft Entra (client credentials flow, client secret). The app sends only as MAIL_SENDER. Its send
# right is either Exchange Online RBAC for Applications (role "Application Mail.Send" scoped to that mailbox – needs an org
# with IsDehydrated = False) or the Microsoft Graph APPLICATION permission Mail.Send with admin consent, which covers EVERY
# mailbox of the tenant and must then be limited to MAIL_SENDER with an Application Access Policy – see /huong-dan#thiet-lap-email.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Sending mailbox (a shared mailbox is recommended), e.g. nennep@example.edu.vn. Its domain is the allowed recipient domain unless Cài đặt → Email
# lists others.
MAIL_SENDER=
# Display name of the sender (default "Nền nếp NSHM").
MAIL_SENDER_NAME=
# Public base URL of the app, used for links in emails and to print report PDFs, e.g. https://nennep.example.edu.vn
# (default: https://$VERCEL_PROJECT_PRODUCTION_URL, then the request origin, then http://localhost:3000).
APP_BASE_URL=
# Secret of the daily Vercel cron GET /api/cron/mail (Vercel sends "Authorization: Bearer $CRON_SECRET"). Long random string.
CRON_SECRET=
# Local development only: Chrome / Chromium that renders report PDFs (default: Google Chrome on macOS / Windows).
# Vercel / Linux use the bundled @sparticuz/chromium.
CHROME_EXECUTABLE_PATH=
# Optional: key of the one-time links Chromium uses to print report PDFs (at least 32 random characters). When empty,
# the key is derived from the Firebase Admin service-account variables above, so nothing needs to be set. A value
# shorter than 32 characters turns report PDFs off (emails go out without the PDF; Cài đặt → Email shows a warning).
PRINT_JOB_SECRET=
